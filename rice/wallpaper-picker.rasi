/* ~/.config/rice/wallpaper-picker.rasi
   Preview grid for wallpaper.sh. Colours come from colors.rasi, which
   theme-sync.py rewrites whenever the wallpaper changes.
   Arrow keys / mouse to move, type to search, Enter to apply, Esc to cancel. */

@import "colors.rasi"

configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 1120px;
    padding: 20px;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    background-color: @bg-alpha;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background-color: @surface;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "search";
    placeholder-color: @muted;
}

listview {
    columns: 4;
    lines: 2;
    spacing: 14px;
    fixed-columns: true;
    cycle: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border-radius: 12px;
    cursor: pointer;
}

element selected {
    background-color: @accent-soft;
    border: 2px;
    border-color: @accent;
}

element-icon {
    size: 230px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    text-color: @muted;
    cursor: inherit;
}

element-text selected {
    text-color: @fg;
}
