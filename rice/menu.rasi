/* ~/.config/rice/menu.rasi
   Shared look for the small menus: settings (Mod+I), power (Mod+Escape),
   clipboard (Mod+Shift+V), keybinds (Mod+/) and troubleshooting (Mod+Shift+N).
   Each script sets its own width and number of lines with -theme-str.
   Colours come from colors.rasi (rewritten by theme-sync.py). */

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 13";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 440px;
    padding: 14px;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    background-color: @bg-alpha;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: @surface;
}

prompt { text-color: @accent; }
entry  { placeholder: "search"; placeholder-color: @muted; }

listview {
    lines: 10;
    spacing: 4px;
    cycle: true;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 8px 12px;
    border-radius: 10px;
    cursor: pointer;
}

element selected {
    background-color: @accent-soft;
    text-color: @fg;
}

element-text {
    text-color: inherit;
    cursor: inherit;
}
