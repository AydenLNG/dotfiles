/* ~/.config/rice/launcher.rasi
   App launcher (Mod+R): grid of app icons with tabs for Apps / Windows / Run.
   Colours come from colors.rasi (rewritten by theme-sync.py).
   Type to search, arrows or mouse to move, Enter to open,
   Ctrl+Tab / Shift+Ctrl+Tab (or click a tab) to switch tabs, Esc to close. */

@import "colors.rasi"

configuration {
    modi: "drun,window,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    window-format: "{c}  {t}";
    display-drun: "Apps";
    display-window: "Windows";
    display-run: "Run";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 760px;
    padding: 18px;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    background-color: @bg-alpha;
}

mainbox {
    children: [ inputbar, mode-switcher, listview ];
    spacing: 14px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    background-color: @surface;
}

prompt { text-color: @accent; }
entry  { placeholder: "search"; placeholder-color: @muted; }

mode-switcher { spacing: 10px; }

button {
    padding: 6px 0;
    border-radius: 10px;
    text-color: @muted;
    background-color: @surface;
    cursor: pointer;
}

button selected {
    text-color: @fg;
    background-color: @accent-soft;
}

listview {
    columns: 5;
    lines: 3;
    spacing: 10px;
    fixed-columns: true;
    cycle: true;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: 12px 6px;
    spacing: 8px;
    border-radius: 12px;
    cursor: pointer;
}

element selected {
    background-color: @accent-soft;
    border: 2px;
    border-color: @accent;
}

element-icon {
    size: 52px;
    horizontal-align: 0.5;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
