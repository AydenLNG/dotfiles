// ~/.config/waybar/config.jsonc
// Glass "islands" bar: three floating pills (workspaces | clock + media | system).
// Drawers keep it tidy: hover the music title for controls, the volume icon for a
// slider, and the chart icon for CPU / GPU / RAM / weather / tray.
// Colours come from colors.css (synced to the wallpaper).
// Icons are Nerd Font glyphs written as \uXXXX escapes.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": ["group/island-left"],
    "modules-center": ["group/island-center"],
    "modules-right": ["group/island-right"],

    // ---------------------------------------------------------------- islands
    "group/island-left": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces", "custom/gamemode"]
    },
    "group/island-center": {
        "orientation": "horizontal",
        "modules": ["clock", "group/media"]
    },
    "group/island-right": {
        "orientation": "horizontal",
        "modules": ["group/volume", "network", "custom/ping", "group/system",
                    "custom/notification", "custom/wallpaper", "custom/power"]
    },

    // ---------------------------------------------------------------- drawers
    // Media: only the title shows; hover it for previous / play-pause / next.
    "group/media": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 350, "children-class": "media-btn", "transition-left-to-right": true },
        "modules": ["mpris", "custom/media-prev", "custom/media-play", "custom/media-next"]
    },
    // Volume: hover the volume for a slider.
    "group/volume": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 350, "children-class": "vol-slider", "transition-left-to-right": true },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },
    // System: hover (or click) the chart icon for CPU, GPU, RAM, weather and tray icons.
    "group/system": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 400, "children-class": "sys-item", "transition-left-to-right": false },
        "modules": ["custom/system", "cpu", "custom/gpu", "memory", "custom/weather", "tray"]
    },

    // ---------------------------------------------------------------- modules
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "custom/gamemode": {
        "exec": "$HOME/.config/rice/gamemode-status.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "$HOME/.config/rice/gamemode.sh"
    },

    // Hover for a month calendar; scroll to change month; right-click for the year.
    "clock": {
        "format": "\uf017  {:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<b>{}</b>",
                "today": "<b><u>{}</u></b>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Song / video playing in any app (Firefox, Spotify...). Title only;
    // click to play / pause, scroll for next / previous.
    "mpris": {
        "format": "\uf001  {dynamic}",
        "format-paused": "\uf001  <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 36,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "custom/media-prev": {
        "format": "\uf048",
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    // Button style: shows pause while playing, play while paused.
    "custom/media-play": {
        "exec": "$HOME/.config/rice/media-status.sh",
        "return-type": "json",
        "on-click": "playerctl play-pause"
    },
    "custom/media-next": {
        "format": "\uf051",
        "tooltip": false,
        "on-click": "playerctl next"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  muted",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    // Icon only; hover for the network name and signal.
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf0e8",
        "format-disconnected": "\uf127",
        "tooltip-format-wifi": "{essid}  {signalStrength}% signal  {frequency} GHz",
        "tooltip-format-ethernet": "Wired ({ifname})",
        "tooltip-format-disconnected": "Offline",
        "on-click": "nm-connection-editor"
    },

    // Internet ping (to 1.1.1.1); hover also shows the router ping, which tells
    // Wi-Fi problems apart from internet problems.
    "custom/ping": {
        "exec": "$HOME/.config/rice/ping.sh",
        "return-type": "json",
        "interval": 10
    },

    "custom/system": {
        "format": "\uf080",
        "tooltip-format": "System stats: hover or click"
    },
    "cpu": {
        "format": "\uf2db  {usage}%",
        "interval": 3
    },
    "custom/gpu": {
        "exec": "$HOME/.config/rice/gpu.sh",
        "return-type": "json",
        "interval": 3
    },
    "memory": {
        "format": "\uf1c0  {percentage}%",
        "interval": 5
    },
    "custom/weather": {
        "exec": "$HOME/.config/rice/weather.sh",
        "return-type": "json",
        "interval": 1800
    },
    "tray": {
        "spacing": 8
    },

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3\u2022",
            "none": "\uf0f3",
            "dnd-notification": "\uf1f6\u2022",
            "dnd-none": "\uf1f6",
            "inhibited-notification": "\uf0f3\u2022",
            "inhibited-none": "\uf0f3",
            "dnd-inhibited-notification": "\uf1f6\u2022",
            "dnd-inhibited-none": "\uf1f6"
        },
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "custom/wallpaper": {
        "format": "",
        "tooltip": false,
        "on-click": "$HOME/.config/rice/wallpaper.sh pick",
        "on-click-right": "$HOME/.config/rice/wallpaper.sh random"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "$HOME/.config/rice/power-menu.sh"
    }
}
