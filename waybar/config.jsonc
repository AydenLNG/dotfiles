// ~/.config/waybar/config.jsonc
// Glass "islands" bar: workspaces | clock + status (the control centre) | tray, bell, ping, battery, power.
// Click the clock or the Wi-Fi / Bluetooth / volume icons to open the control
// centre (also Super+I): calendar, toggles, sliders, timers, CPU / GPU / RAM, ping.
// Colours come from colors.css (synced to the wallpaper).
// Icons are Nerd Font glyphs written as \uXXXX escapes.
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": ["group/island-left"],
    "modules-center": ["group/island-center"],
    "modules-right": ["group/island-right"],

    // ---------------------------------------------------------------- islands
    "group/island-left": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces", "custom/gamemode"]
    },
    "group/island-center": {
        "orientation": "horizontal",
        "modules": ["clock", "network", "bluetooth", "pulseaudio", "custom/hub-arrow"]
    },
    "group/island-right": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/notification", "custom/ping", "custom/battery", "custom/power"]
    },

    // ---------------------------------------------------------------- modules
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "custom/gamemode": {
        "exec": "$HOME/.config/rice/gamemode-status.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "$HOME/.config/rice/gamemode.sh"
    },

    // Click: control centre (calendar inside). Same for the status icons next to it.
    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "tooltip": false,
        "on-click": "$HOME/.config/rice/hub.sh"
    },

    // Volume: click for the control centre, scroll to change, right-click to mute.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "tooltip-format": "Volume {volume}% ({desc})",
        "on-click": "$HOME/.config/rice/hub.sh",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    // Icon only; hover for the network name and signal. Click: control centre.
    // Right-click: pick and join a Wi-Fi network.
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf0e8",
        "format-disconnected": "\uf127",
        "tooltip-format-wifi": "{essid}  {signalStrength}% signal",
        "tooltip-format-ethernet": "Wired",
        "tooltip-format-disconnected": "Offline",
        "on-click": "$HOME/.config/rice/hub.sh",
        "on-click-right": "setsid -f kitty --class rice-dialog --title 'Wi-Fi' nmtui connect"
    },

    // Hidden when the computer has no Bluetooth adapter. Dim when off.
    "bluetooth": {
        "format": "\uf293",
        "format-off": "\uf293",
        "format-disabled": "",
        "format-no-controller": "",
        "format-connected": "\uf293",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "Bluetooth: {device_alias}",
        "tooltip-format-off": "Bluetooth off",
        "on-click": "$HOME/.config/rice/hub.sh",
        "on-click-right": "blueman-manager"
    },

    "tray": {
        "spacing": 8
    },

    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf0f3\u2022",
            "none": "\uf0f3",
            "dnd-notification": "\uf1f6\u2022",
            "dnd-none": "\uf1f6",
            "inhibited-notification": "\uf0f3\u2022",
            "inhibited-none": "\uf0f3",
            "dnd-inhibited-notification": "\uf1f6\u2022",
            "dnd-inhibited-none": "\uf1f6"
        },
        "tooltip": false,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    // Internet ping (to 1.1.1.1) every 10 s; hover also shows the router ping,
    // which tells Wi-Fi problems apart from internet problems.
    "custom/ping": {
        "exec": "$HOME/.config/rice/ping.sh",
        "return-type": "json",
        "interval": 10
    },

    // Small arrow at the end of the centre island: shows it opens a dropdown.
    "custom/hub-arrow": {
        "format": "\uf107",
        "tooltip": false,
        "on-click": "$HOME/.config/rice/hub.sh"
    },

    // Laptops only (hidden on a desktop). Yellow at 20 %, red and blinking at 10 %.
    "custom/battery": {
        "exec": "$HOME/.config/rice/battery.sh",
        "return-type": "json",
        "interval": 30,
        "on-click": "$HOME/.config/rice/hub.sh"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "$HOME/.config/rice/power-menu.sh"
    }
}
