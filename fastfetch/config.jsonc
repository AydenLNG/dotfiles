// ~/.config/fastfetch/config.jsonc
// Shows a random picture from ~/Pictures/Fetch as the logo (separate from
// your wallpapers). Put only images in that folder: png, jpg or webp.
// Pictures only show in kitty; other terminals fall back to the text logo.
// The module list is fastfetch's default minus "localip", so screenshots
// you share never show your local IP address.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-icat",
        "source": "~/Pictures/Fetch/*",
        "width": 30,
        "height": 15,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "modules": [
        "title", "separator",
        "os", "host", "kernel", "uptime", "packages", "shell",
        "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
        "terminal", "terminalfont",
        "cpu", "gpu", "memory", "swap", "disk",
        "battery", "poweradapter", "locale",
        "break", "colors"
    ]
}
