// ~/.config/fastfetch/config.jsonc
// Shows a random picture from ~/Pictures/Fetch as the logo (separate from
// your wallpapers). Put only images in that folder: png, jpg or webp.
// Pictures only show in kitty; other terminals fall back to the text logo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/Pictures/Fetch/*",
        "width": 30,
        "padding": { "top": 1, "left": 2, "right": 3 }
    }
}
